{
  "name": "metagpt-ts",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/core build && bun run --cwd packages/ui build",
    "dev": "bun run --cwd packages/ui dev",
    "lint": "bun run --cwd packages/core lint && bun run --cwd packages/ui lint",
    "test": "bun run --cwd packages/core test && bun run --cwd packages/ui test",
    "clean": "rm -rf packages/*/dist packages/*/node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "uuid": "^11.1.0"
  }
}
